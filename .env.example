# ==============================================================================
# SAFE JOURNEYS HAPPY MEMORIES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual production values.
# NEVER commit the real .env file with secrets into public repositories.
# ==============================================================================

# Business Owner Email (Receives all incoming ride booking notices)
OWNER_EMAIL=naminathtravels22@gmail.com

# Customer Support Helpline Phone
SUPPORT_PHONE=+91 98765 43210

# Brevo (Sendinblue) Transactional Email API Key
# Sign up free at https://www.brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=Safe Journeys Happy Memories
BREVO_SENDER_EMAIL=naminathtravels22@gmail.com

# Optional: EmailJS Configuration (Fallback)
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Server Port (Default: 8085)
PORT=8085
NODE_ENV=production
